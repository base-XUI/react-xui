{
  "name": "@base-xui/react-xui",
  "private": false,
  "version": "0.1.0",
  "description": "React XUI Component Library",
  "main": "./dist/umd/react-xui.umd.js",
  "module": "./dist/es/src/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/src/index.js",
      "require": "./dist/umd/react-xui.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/base-XUI/react-xui.git"
  },
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "base-XUI/react-xui"
    }
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "dev:link": "pnpm build:package && yalc push",
    "dev:publish": "pnpm build:package && yalc publish",
    "dev:watch": "concurrently \"pnpm build:package --watch\" \"yalc push --watch\"",
    "build:package": "pnpm clean && tsc -p tsconfig.build.json && vite build && pnpm build:css --mode package",
    "build:storybook": "storybook build",
    "build:css": "pnpm dlx @tailwindcss/cli -i lib/src/main.css -o dist/styles.css --minify",
    "release": "pnpm build:package && changeset publish",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "rimraf dist",
    "test:unit": "cypress run --component",
    "test:unit:ui": "cypress open --component",
    "test:e2e": "cypress run",
    "test:e2e:ui": "cypress open --e2e",
    "prepublishOnly": "pnpm lint && pnpm test:unit && pnpm build:package"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-xui/react-xui": "file:.yalc/@base-xui/react-xui",
    "@tailwindcss/cli": "^4.0.14",
    "@tailwindcss/vite": "^4.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.6",
    "tailwindcss-animate": "^1.0.7",
    "yalc": "1.0.0-pre.53"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.cy.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "**/*": "prettier --write --ignore-unknown"
  },
  "yalcSig": "7e2b5d00176ea78574a9d142f37dd924"
}
